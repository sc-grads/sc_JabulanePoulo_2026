        <SQLTask:SqlTaskData
          SQLTask:Connection="{F0060773-58BE-468A-BA0E-B64130E17EFF}"
          SQLTask:SqlStatementSource="USE HackathonDB;&#xA;GO&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;------------------------------------------------------------&#xA;-- 1. CRIMES AGAINST PERSON&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.CrimesAgainstPerson&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Murder', 25181, 27494, 2313, '9.2%',&#xA; 5150, 979, 6411, 6947, 1013, 1344, 392, 1108, 4150),&#xA;&#xA;('Sexual offences', 52694, 53498, 804, '1.5%',&#xA; 8269, 3415, 10997, 10106, 4689, 3294, 1535, 3899, 7294),&#xA;&#xA;('Attempted murder', 22095, 25131, 3036, '13.7%',&#xA; 2519, 1326, 6161, 6307, 1068, 1417, 1700, 1039, 3594),&#xA;&#xA;('Assault with the intent to inflict grievous bodily harm',&#xA; 162842, 169374, 6532, '4.0%',&#xA; 24218, 12030, 38031, 26397, 13205, 10766, 6810, 14377, 23540),&#xA;&#xA;('Common assault', 169963, 185374, 15411, '9.1%',&#xA; 15095, 15541, 50891, 25965, 10889, 8810, 5761, 10622, 41800),&#xA;&#xA;('Common robbery', 41600, 47057, 5457, '13.1%',&#xA; 2903, 1945, 15682, 7562, 3232, 2007, 1107, 2539, 10080),&#xA;&#xA;('Robbery with aggravating circumstances',&#xA; 132788, 146125, 13337, '10.0%',&#xA; 13021, 4603, 53633, 26798, 8004, 8948, 1569, 7108, 22441),&#xA;&#xA;('Contact crime (crime against the person)',&#xA; 607163, 654053, 46890, '7.7%',&#xA; 71175, 39839, 181806, 110082, 42100, 36586, 18874, 40692, 112899);&#xA;&#xA;------------------------------------------------------------&#xA;-- 2. SEXUAL OFFENCES&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.SexualOffences&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Rape', 41739, 42780, 1041, '2.5%',&#xA; 6829, 2671, 8708, 8433, 4021, 2772, 1099, 3218, 5029),&#xA;&#xA;('Sexual assault', 7798, 7483, -315, '-4.0%',&#xA; 913, 488, 1863, 1140, 391, 374, 253, 387, 1674),&#xA;&#xA;('Attempted sexual offences', 2027, 2376, 349, '17.2%',&#xA; 419, 163, 273, 394, 229, 103, 144, 245, 406),&#xA;&#xA;('Contact sexual offences', 1130, 859, -271, '-24.0%',&#xA; 108, 93, 153, 139, 48, 45, 39, 49, 185);&#xA;&#xA;------------------------------------------------------------&#xA;-- 3. SUB-CATEGORIES OF ROBBERY&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.SubCategoriesRobbery&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Carjacking', 20923, 22702, 1779, '8.5%',&#xA; 1866, 271, 11248, 3731, 569, 1271, 38, 612, 3096),&#xA;&#xA;('Robbery at residential premises', 21832, 23065, 1233, '5.6%',&#xA; 2154, 638, 7728, 5991, 1354, 1582, 157, 1093, 2368),&#xA;&#xA;('Robbery at non-residential premises', 20012, 20054, 42, '0.2%',&#xA; 2205, 871, 6312, 3531, 1943, 1947, 269, 1394, 1582),&#xA;&#xA;('TRIO Crime', 62767, 65821, 3054, '4.9%',&#xA; 6225, 1780, 25288, 13253, 3866, 4800, 464, 3099, 7046),&#xA;&#xA;('Robbery of cash in transit', 238, 238, 0, '0.0%',&#xA; 45, 7, 88, 33, 24, 21, 1, 8, 11),&#xA;&#xA;('Bank robbery', 13, 4, -9, '9 counts lower',&#xA; 2, 0, 2, 0, 0, 0, 0, 0, 0),&#xA;&#xA;('Truck hijacking', 1741, 1995, 254, '14.6%',&#xA; 176, 53, 1219, 105, 38, 229, 2, 67, 106);&#xA;&#xA;------------------------------------------------------------&#xA;-- 4. CONTACT-RELATED CRIMES&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.ContactRelatedCrimes&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Arson', 4102, 3626, -476, '-11.6%',&#xA; 583, 142, 440, 690, 344, 270, 196, 250, 711),&#xA;&#xA;('Malicious damage to property', 113403, 115118, 1715, '1.5%',&#xA; 12874, 6985, 28767, 14083, 7808, 5761, 4077, 6903, 27860),&#xA;&#xA;('Contact-related crime', 117505, 118744, 1239, '1.1%',&#xA; 13457, 7127, 29207, 14773, 8152, 6031, 4273, 7153, 28571);&#xA;&#xA;------------------------------------------------------------&#xA;-- 5. PROPERTY-RELATED CRIMES&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.PropertyRelatedCrimes&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Burglary at non-residential premises', 62197, 62588, 391, '0.6%',&#xA; 7698, 5008, 13599, 8882, 6007, 5279, 2759, 4996, 8360),&#xA;&#xA;('Burglary at residential premises', 156170, 163493, 7323, '4.7%',&#xA; 18916, 11659, 35899, 26578, 11768, 12285, 6363, 11850, 28175),&#xA;&#xA;('Theft of motor vehicle and motorcycle', 37402, 37461, 59, '0.2%',&#xA; 1693, 793, 19530, 6343, 777, 1484, 162, 1723, 4956),&#xA;&#xA;('Theft out of or from motor vehicle', 81504, 87173, 5669, '7.0%',&#xA; 8681, 4147, 23931, 11813, 3412, 4490, 2227, 4396, 24076),&#xA;&#xA;('Stock-theft', 25001, 25255, 254, '1.0%',&#xA; 5561, 3024, 1112, 5665, 2539, 2722, 987, 2955, 690),&#xA;&#xA;('Property-related crime', 362274, 375970, 13696, '3.8%',&#xA; 42549, 24631, 94071, 59281, 24503, 26260, 12498, 25920, 66257);&#xA;&#xA;------------------------------------------------------------&#xA;-- 6. OTHER SERIOUS CRIMES&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.OtherSeriousCrimes&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('All theft not mentioned elsewhere', 249215, 275452, 26237, '10.5%',&#xA; 25440, 16985, 75296, 37292, 17452, 13682, 8652, 16088, 64565),&#xA;&#xA;('Commercial crime', 102057, 112592, 10535, '10.3%',&#xA; 10295, 4351, 37581, 18247, 5853, 5990, 1872, 7110, 21293),&#xA;&#xA;('Shoplifting', 42549, 49697, 7148, '16.8%',&#xA; 3768, 2513, 15659, 8033, 3350, 3048, 1345, 1918, 10063),&#xA;&#xA;('Other serious crime', 393821, 437741, 43920, '11.2%',&#xA; 39503, 23849, 128536, 63572, 26655, 22720, 11869, 25116, 95921),&#xA;&#xA;('17 Community reported serious crime',&#xA; 1480763, 1586508, 105745, '7.1%',&#xA; 166684, 95446, 433620, 247708, 101410, 91597, 47514, 98881, 303648);&#xA;&#xA;------------------------------------------------------------&#xA;-- 7. CRIME DETECTED AS A RESULT OF POLICE ACTION&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.CrimeDetectedOfPoliceStation&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Illegal possession of firearms and ammunition',&#xA; 13549, 15649, 2100, '15.5%',&#xA; 2038, 563, 4273, 3717, 636, 814, 70, 742, 2796),&#xA;&#xA;('Drug-related crime',&#xA; 140326, 162122, 21796, '15.5%',&#xA; 11135, 5607, 34963, 23045, 6833, 5001, 2579, 5896, 67063),&#xA;&#xA;('Driving under the influence of alcohol or drugs',&#xA; 43873, 41768, -2105, '-4.8%',&#xA; 2970, 2468, 18676, 2783, 1607, 1447, 251, 2310, 9256),&#xA;&#xA;('Sexual offences detected as a result of police action',&#xA; 7242, 9589, 2347, '32.4%',&#xA; 18, 1184, 1458, 2694, 2927, 7, 3, 1257, 41),&#xA;&#xA;('Crime detected as a result of police action',&#xA; 204990, 229128, 24138, '11.8%',&#xA; 16161, 9822, 59370, 32239, 12003, 7269, 2903, 10205, 79156);&#xA;&#xA;------------------------------------------------------------&#xA;-- 8. KIDNAPPING&#xA;------------------------------------------------------------&#xA;INSERT INTO dbo.Kidnapping&#xA;(&#xA;    CrimeCategory,&#xA;    [2021-2022],&#xA;    [2022-2023],&#xA;    CountDiff,&#xA;    [%Change],&#xA;    EC, FS, G, KZN, LP, MP, NC, NW, WC&#xA;)&#xA;VALUES&#xA;('Kidnapping',&#xA; 10826, 15342, 4516, '41.7%',&#xA; 784, 538, 7822, 3089, 452, 979, 98, 628, 952);&#xA;&#xA;------------------------------------------------------------&#xA;-- FINISH&#xA;------------------------------------------------------------&#xA;COMMIT TRANSACTION;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
