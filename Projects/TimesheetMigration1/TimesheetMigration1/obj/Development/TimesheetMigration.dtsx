    <DTS:Executable
      DTS:refId="Package\Move  Staging to Final"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DAC3EDC5-D9A9-412F-9C29-4CE7DC8D8F23}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:MaxErrorCount="5"
      DTS:ObjectName="Move  Staging to Final"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1D22DA80-7A51-40FD-85E9-5DD430FF0656}"
          SQLTask:SqlStatementSource="-- =============================================&#xA;-- Complete ETL Script with HoursWorked calculated from StartTime/EndTime&#xA;-- =============================================&#xA;&#xA;-- 1. CLEAN NULL values&#xA;UPDATE staging.Timesheet&#xA;SET &#xA;    StartTime = CASE WHEN ISNULL(StartTime, '') = '' THEN '00:00:00' ELSE StartTime END,&#xA;    EndTime = CASE WHEN ISNULL(EndTime, '') = '' THEN '00:00:00' ELSE EndTime END&#xA;WHERE Processed = 0 &#xA;  AND (StartTime IS NULL OR StartTime = '' OR EndTime IS NULL OR EndTime = '');&#xA;&#xA;-- 2. UPDATE EmployeeID FROM SourceFile&#xA;UPDATE s&#xA;SET s.EmployeeID = e.EmployeeID&#xA;FROM staging.Timesheet s&#xA;INNER JOIN timesheet.Employee e&#xA;ON CONCAT(e.FirstName,' ',e.LastName) =&#xA;CASE&#xA;    WHEN s.SourceFile LIKE '%Buhle_Mukhuba%' THEN 'Buhle Mukhuba'&#xA;    WHEN s.SourceFile LIKE '%Charmane_Mchunu%' THEN 'Charmane Mchunu'&#xA;    WHEN s.SourceFile LIKE '%Jabulane_Poulo%' THEN 'Jabulane Poulo'&#xA;    WHEN s.SourceFile LIKE '%Kayden_Padayachee%' THEN 'Kayden Padayachee'&#xA;    WHEN s.SourceFile LIKE '%Lwazisile_Mhlambi%' THEN 'Lwazisile Mhlambi'&#xA;    WHEN s.SourceFile LIKE '%Rushil_Jivan%' THEN 'Rushil Jivan'&#xA;    WHEN s.SourceFile LIKE '%Shriya_Hariparsad%' THEN 'Shriya Hariparsad'&#xA;    WHEN s.SourceFile LIKE '%Teolan_Govender%' THEN 'Teolan Govender'&#xA;ELSE NULL&#xA;END&#xA;WHERE s.Processed = 0;&#xA;&#xA;-- 3. INSERT INTO FINAL TABLE&#xA;INSERT INTO timesheet.Timesheet&#xA;(&#xA;    EmployeeID,&#xA;    WorkDate,&#xA;    DayOfWeek,&#xA;    WorkDescription,&#xA;    Comments,&#xA;    HoursWorked,&#xA;    StartTime,&#xA;    EndTime,&#xA;    ClientID,&#xA;    BillableStatus&#xA;)&#xA;SELECT&#xA;    s.EmployeeID,&#xA;    CAST(s.WorkDate AS DATE),&#xA;    s.DayOfWeek,&#xA;    s.WorkDescription,&#xA;    s.Comments,&#xA;    -- Calculate HoursWorked from StartTime and EndTime (HH:MM format)&#xA;    CONVERT(VARCHAR(5), &#xA;        DATEADD(SECOND, &#xA;            DATEDIFF(SECOND, s.StartTime, s.EndTime), &#xA;            '00:00:00'&#xA;        ), &#xA;        108&#xA;    ) AS HoursWorked,&#xA;    CAST(s.StartTime AS TIME(0)) AS StartTime,&#xA;    CAST(s.EndTime AS TIME(0)) AS EndTime,&#xA;    CASE&#xA;        WHEN UPPER(LTRIM(RTRIM(s.ClientName))) = 'INTERNAL SAMBE' THEN 1&#xA;WHEN UPPER(LTRIM(RTRIM(s.ClientName))) = 'DISCOVERY' THEN 2&#xA;WHEN UPPER(LTRIM(RTRIM(s.ClientName))) = 'SANLAM' THEN 3&#xA;    END AS ClientID,&#xA;    s.BillableStatus&#xA;FROM staging.Timesheet s&#xA;WHERE s.Processed = 0&#xA;  AND s.EmployeeID IS NOT NULL&#xA;  AND s.WorkDate IS NOT NULL&#xA;  AND s.Comments IS NOT NULL&#xA;  AND s.StartTime IS NOT NULL&#xA;  AND s.EndTime IS NOT NULL&#xA;  AND LTRIM(RTRIM(s.WorkDescription)) &lt;&gt; '.NET code'&#xA;  AND DATENAME(WEEKDAY, CAST(s.WorkDate AS DATE)) NOT IN ('Saturday','Sunday')&#xA;  AND CAST(s.WorkDate AS DATE) NOT IN (&#xA;      '2026-01-01', '2026-03-21', '2026-04-03', '2026-04-06',&#xA;      '2026-04-27', '2026-05-01', '2026-06-16', '2026-08-09',&#xA;      '2026-09-24', '2026-12-16', '2026-12-25', '2026-12-26'&#xA;  )&#xA;  AND NOT EXISTS (&#xA;      SELECT 1&#xA;      FROM timesheet.Timesheet t&#xA;      WHERE t.EmployeeID = s.EmployeeID&#xA;        AND t.WorkDate = CAST(s.WorkDate AS DATE)&#xA;        AND t.WorkDescription = s.WorkDescription&#xA;        AND ISNULL(t.Comments,'') = ISNULL(s.Comments,'')&#xA;  )&#xA;  AND EXISTS (&#xA;      SELECT 1 &#xA;      FROM timesheet.Employee e &#xA;      WHERE e.EmployeeID = s.EmployeeID&#xA;  );&#xA;&#xA;-- 4. MARK STAGING RECORDS AS PROCESSED&#xA;UPDATE staging.Timesheet&#xA;SET&#xA;    Processed = 1,&#xA;    ProcessedAt = GETDATE()&#xA;WHERE Processed = 0&#xA;  AND EmployeeID IS NOT NULL&#xA;  AND EXISTS (&#xA;      SELECT 1 &#xA;      FROM timesheet.Employee e &#xA;      WHERE e.EmployeeID = staging.Timesheet.EmployeeID&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update Audit Log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8F538F78-0FCD-4CD8-B9BD-1BF9383B6336}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Audit Log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1D22DA80-7A51-40FD-85E9-5DD430FF0656}"
          SQLTask:SqlStatementSource="-- =============================================&#xA;-- 5. COUNT THE ROWS THAT WERE JUST INSERTED (BEFORE MARKING PROCESSED)&#xA;-- =============================================&#xA;DECLARE @RowsInserted INT;&#xA;SELECT @RowsInserted = COUNT(*) &#xA;FROM staging.Timesheet &#xA;WHERE Processed = 0 &#xA;  AND EmployeeID IS NOT NULL;&#xA;&#xA;-- =============================================&#xA;-- 6. WRITE TO AUDIT LOG&#xA;-- =============================================&#xA;INSERT INTO [audit].[AuditLog] (&#xA;    LogDateTime,&#xA;    TaskName,&#xA;    LogStatus,&#xA;    RowsInserted,&#xA;    RowsUpdated,&#xA;    RowsDeleted,&#xA;    Message&#xA;)&#xA;VALUES (&#xA;    GETDATE(),&#xA;    'Move Staging to Final',&#xA;    'SUCCESS',&#xA;    @RowsInserted,&#xA;    0,&#xA;    0,&#xA;    CONCAT('Successfully inserted ', @RowsInserted, ' rows into timesheet.Timesheet.')&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RunNumber"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
