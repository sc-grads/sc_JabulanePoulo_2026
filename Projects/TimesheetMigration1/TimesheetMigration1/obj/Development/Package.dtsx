        <SQLTask:SqlTaskData
          SQLTask:Connection="{555C195A-3047-4725-83D2-CDBBB8459805}"
          SQLTask:SqlStatementSource="UPDATE audit.ETLLog &#xA;SET &#xA;    EmployeeCode = ?,&#xA;    EmployeeName = ?,&#xA;    Month = ?,&#xA;    SourceFile = ?,&#xA;    SourcePath = ?,&#xA;    RowsProcessed = ?,&#xA;    StatusCode = CASE WHEN ? = 0 THEN 0 ELSE 1 END,&#xA;    StatusMessage = CASE &#xA;        WHEN ? = 0 THEN 'Success' &#xA;        ELSE 'Completed with errors' &#xA;    END,&#xA;    CompletedAt = GETUTCDATE()&#xA;WHERE EmployeeCode = ?" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::EmployeeCode"
