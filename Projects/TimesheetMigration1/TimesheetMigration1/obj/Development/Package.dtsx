      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{555C195A-3047-4725-83D2-CDBBB8459805}"
          SQLTask:SqlStatementSource="INSERT INTO audit.ETLLog (&#xA;    EmployeeCode,&#xA;    EmployeeName,&#xA;    Month,&#xA;    StartedAt,&#xA;    StatusCode,&#xA;    StatusMessage&#xA;) VALUES (&#xA;    ?,&#xA;    ?,&#xA;    ?,&#xA;    GETUTCDATE(),&#xA;    1,&#xA;    'Starting timesheet migration'&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::EmployeeCode"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::EmployeeName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::Month"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
