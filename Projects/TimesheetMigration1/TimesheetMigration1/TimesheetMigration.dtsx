        <SQLTask:SqlTaskData
          SQLTask:Connection="{12C26D31-71E3-4084-85A3-C3363301A0C8}"
          SQLTask:SqlStatementSource="-- Delete all existing records&#xA;DELETE FROM timesheet.EmployeeLeave;&#xA;&#xA;-- Insert new records&#xA;INSERT INTO timesheet.EmployeeLeave&#xA;(&#xA;    EmployeeID,&#xA;    LeaveType,&#xA;    StartDate,&#xA;    EndDate,&#xA;    NumberOfDays&#xA;)&#xA;VALUES&#xA;(1, 'Annual Leave', '2026-05-13', '2026-05-15', 3.00),&#xA;(2, 'Annual Leave', '2026-05-13', '2026-05-15', 3.00),&#xA;(3, 'Annual Leave', '2026-05-19', '2026-05-20', 1.00),&#xA;(4, 'Annual Leave', '2026-05-20', '2026-05-21', 1.00),&#xA;(8, 'Annual Leave', '2026-05-13', '2026-05-14', 1.00);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
