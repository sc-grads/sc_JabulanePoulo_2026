    <DTS:Executable
      DTS:refId="Package\Move  Staging to Final"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DAC3EDC5-D9A9-412F-9C29-4CE7DC8D8F23}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Move  Staging to Final"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12C26D31-71E3-4084-85A3-C3363301A0C8}"
          SQLTask:SqlStatementSource="-- =============================================&#xA;-- 1. CLEAN NULL HoursWorked&#xA;-- =============================================&#xA;UPDATE staging.Timesheet&#xA;SET HoursWorked = 0&#xA;WHERE HoursWorked IS NULL&#xA;  AND Processed = 0;&#xA;&#xA;-- =============================================&#xA;-- 2. UPDATE EmployeeID FROM SourceFile&#xA;-- =============================================&#xA;UPDATE s&#xA;SET s.EmployeeID = e.EmployeeID&#xA;FROM staging.Timesheet s&#xA;INNER JOIN timesheet.Employee e&#xA;ON CONCAT(e.FirstName,' ',e.LastName)=&#xA;CASE&#xA;    WHEN s.SourceFile LIKE '%Buhle_Mkubha%' THEN 'Buhle Mkubha'&#xA;    WHEN s.SourceFile LIKE '%Charmane_Mchunu%' THEN 'Charmane Mchunu'&#xA;    WHEN s.SourceFile LIKE '%Jabulane_Poulo%' THEN 'Jabulane Poulo'&#xA;    WHEN s.SourceFile LIKE '%Kayden_Padayachee%' THEN 'Kayden Padayachee'&#xA;    WHEN s.SourceFile LIKE '%Lwazisile_Mhlambi%' THEN 'Lwazisile Mhlambi'&#xA;    WHEN s.SourceFile LIKE '%Rushil_Jivan%' THEN 'Rushil Jivan'&#xA;    WHEN s.SourceFile LIKE '%Shriya_Hariparsad%' THEN 'Shriya Hariparsad'&#xA;    WHEN s.SourceFile LIKE '%Teolan_Govender%' THEN 'Teolan Govender'&#xA;END&#xA;WHERE s.Processed = 0;&#xA;&#xA;-- =============================================&#xA;-- 3. INSERT INTO FINAL TABLE&#xA;-- =============================================&#xA;INSERT INTO timesheet.Timesheet&#xA;(&#xA;    EmployeeID,&#xA;    WorkDate,&#xA;    DayOfWeek,&#xA;    WorkDescription,&#xA;    Comments,&#xA;    HoursWorked,&#xA;    StartTime,&#xA;    EndTime,&#xA;    ClientID,&#xA;    BillableStatus&#xA;)&#xA;SELECT&#xA;    s.EmployeeID,&#xA;    CAST(s.WorkDate AS DATE),&#xA;    s.DayOfWeek,&#xA;    s.WorkDescription,&#xA;    s.Comments,&#xA;&#xA;    -- Use the value imported from Excel&#xA;    CAST(ISNULL(s.HoursWorked,0) AS DECIMAL(5,2)) AS HoursWorked,&#xA;&#xA;    s.StartTime,&#xA;    s.EndTime,&#xA;&#xA;    CASE&#xA;        WHEN LTRIM(RTRIM(s.ClientName)) = 'Internal Sambe' THEN 1&#xA;        WHEN LTRIM(RTRIM(s.ClientName)) = 'Discovery' THEN 2&#xA;        ELSE NULL&#xA;    END AS ClientID,&#xA;&#xA;    s.BillableStatus&#xA;&#xA;FROM staging.Timesheet s&#xA;&#xA;WHERE s.Processed = 0&#xA;  AND s.EmployeeID IS NOT NULL&#xA;  AND s.WorkDate IS NOT NULL&#xA;  AND s.Comments IS NOT NULL&#xA;  AND LTRIM(RTRIM(s.WorkDescription)) &lt;&gt; '.NET code'&#xA;&#xA;  -- Exclude weekends&#xA;  AND DATENAME(WEEKDAY, CAST(s.WorkDate AS DATE))&#xA;      NOT IN ('Saturday','Sunday')&#xA;&#xA;  -- Exclude public holidays&#xA;  AND CAST(s.WorkDate AS DATE) NOT IN&#xA;  (&#xA;      '2026-01-01',&#xA;      '2026-03-21',&#xA;      '2026-04-03',&#xA;      '2026-04-06',&#xA;      '2026-04-27',&#xA;      '2026-05-01',&#xA;      '2026-06-16',&#xA;      '2026-08-09',&#xA;      '2026-09-24',&#xA;      '2026-12-16',&#xA;      '2026-12-25',&#xA;      '2026-12-26'&#xA;  )&#xA;&#xA;  -- Prevent duplicate records&#xA;  AND NOT EXISTS&#xA;  (&#xA;      SELECT 1&#xA;      FROM timesheet.Timesheet t&#xA;      WHERE t.EmployeeID = s.EmployeeID&#xA;        AND t.WorkDate = CAST(s.WorkDate AS DATE)&#xA;        AND t.WorkDescription = s.WorkDescription&#xA;        AND ISNULL(t.Comments,'') = ISNULL(s.Comments,'')&#xA;  );&#xA;&#xA;-- =============================================&#xA;-- 4. CAPTURE ROWS INSERTED&#xA;-- =============================================&#xA;DECLARE @RowsInserted INT = @@ROWCOUNT;&#xA;&#xA;-- =============================================&#xA;-- 5. MARK STAGING RECORDS AS PROCESSED&#xA;-- =============================================&#xA;UPDATE staging.Timesheet&#xA;SET&#xA;    Processed = 1,&#xA;    ProcessedAt = GETDATE()&#xA;WHERE Processed = 0&#xA;  AND EmployeeID IS NOT NULL;&#xA;&#xA;-- =============================================&#xA;-- 6. UPDATE AUDIT LOG&#xA;-- =============================================&#xA;UPDATE audit.AuditLog&#xA;SET&#xA;    RowsInserted = @RowsInserted,&#xA;    LogStatus = 'SUCCESS',&#xA;    Message = CONCAT(&#xA;        'Timesheet migration completed successfully. ',&#xA;        @RowsInserted,&#xA;        ' rows inserted.'&#xA;    ),&#xA;    ExecutionDurationMs = DATEDIFF(MILLISECOND, LogDateTime, GETDATE())&#xA;WHERE TaskName = 'Timesheet Migration';&#xA;&#xA;-- =============================================&#xA;-- 7. RETURN ROW COUNT TO SSIS&#xA;-- =============================================&#xA;SELECT @RowsInserted AS RowsInserted;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update Audit Log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8F538F78-0FCD-4CD8-B9BD-1BF9383B6336}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Audit Log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12C26D31-71E3-4084-85A3-C3363301A0C8}"
          SQLTask:SqlStatementSource="UPDATE audit.AuditLog &#xA;SET &#xA;    LogStatus = 'SUCCESS',&#xA;    RowsInserted = ?,&#xA;    ExecutionDurationMs = DATEDIFF(MILLISECOND, LogDateTime, GETDATE()),&#xA;    Message = 'Timesheet migration completed successfully'&#xA;WHERE RunNumber = ? AND TaskName = 'Timesheet Migration'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RunNumber"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
