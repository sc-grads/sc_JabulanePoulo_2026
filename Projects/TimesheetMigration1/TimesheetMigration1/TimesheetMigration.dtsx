          SQLTask:Connection="{12C26D31-71E3-4084-85A3-C3363301A0C8}"
          SQLTask:SqlStatementSource="INSERT INTO audit.AuditLog&#xA;(&#xA;    LogDateTime,&#xA;    RunNumber,&#xA;    LogSource,&#xA;    TaskName,&#xA;    LogStatus,&#xA;    ExecutedBy,&#xA;    TargetTable&#xA;)&#xA;VALUES&#xA;(&#xA;    GETDATE(),&#xA;    ?,&#xA;    'SSIS Package',&#xA;    'Timesheet Migration',&#xA;    'STAGED',&#xA;    SYSTEM_USER,&#xA;    'staging.Timesheet'&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RunNumber"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
