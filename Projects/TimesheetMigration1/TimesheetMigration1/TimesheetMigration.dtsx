    <DTS:Executable
      DTS:refId="Package\Move  Staging to Final"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DAC3EDC5-D9A9-412F-9C29-4CE7DC8D8F23}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Move  Staging to Final"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12C26D31-71E3-4084-85A3-C3363301A0C8}"
          SQLTask:SqlStatementSource="-- =============================================&#xA;-- 1. CHECK FOR NULL TotalHours&#xA;-- =============================================&#xA;DECLARE @NullCount INT;&#xA;SELECT @NullCount = COUNT(*) &#xA;FROM staging.Timesheet &#xA;WHERE TotalHours IS NULL AND Processed = 0;&#xA;&#xA;IF @NullCount &gt; 0&#xA;BEGIN&#xA;    UPDATE staging.Timesheet&#xA;    SET TotalHours = 0&#xA;    WHERE TotalHours IS NULL AND Processed = 0;&#xA;END&#xA;&#xA;-- =============================================&#xA;-- 2. UPDATE EmployeeID&#xA;-- =============================================&#xA;UPDATE s&#xA;SET s.EmployeeID = e.EmployeeID&#xA;FROM staging.Timesheet s&#xA;INNER JOIN timesheet.Employee e &#xA;    ON e.FullName = &#xA;        CASE &#xA;            WHEN s.SourceFile LIKE '%Buhle_Mkubha%' THEN 'Buhle Mkubha'&#xA;            WHEN s.SourceFile LIKE '%Charmane_Mchunu%' THEN 'Charmane Mchunu'&#xA;            WHEN s.SourceFile LIKE '%Jubulane_Poulo%' THEN 'Jubulane Poulo'&#xA;            WHEN s.SourceFile LIKE '%Kayden_Padyadache%' THEN 'Kayden Padyadache'&#xA;            WHEN s.SourceFile LIKE '%Lwazisile_Mhlambi%' THEN 'Lwazisile Mhlambi'&#xA;            WHEN s.SourceFile LIKE '%Rushil_Jivan%' THEN 'Rushil Jivan'&#xA;            WHEN s.SourceFile LIKE '%Shriya_Hariprasad%' THEN 'Shriya Hariprasad'&#xA;            WHEN s.SourceFile LIKE '%Teolan_Govender%' THEN 'Teolan Govender'&#xA;            ELSE NULL&#xA;        END&#xA;WHERE s.Processed = 0;&#xA;&#xA;-- =============================================&#xA;-- 3. INSERT INTO FINAL TABLE&#xA;-- =============================================&#xA;INSERT INTO timesheet.Timesheet&#xA;(&#xA;    EmployeeID,&#xA;    WorkDate,&#xA;    DayOfWeek,&#xA;    ClientName,&#xA;    WorkDescription,&#xA;    Comments,&#xA;    TotalHours,&#xA;    StartTime,&#xA;    EndTime,&#xA;    SourceFile&#xA;)&#xA;SELECT &#xA;    s.EmployeeID,&#xA;    s.WorkDate,&#xA;    s.DayOfWeek,&#xA;    s.ClientName,&#xA;    s.WorkDescription,&#xA;    s.Comments,&#xA;    ISNULL(s.TotalHours, 0),&#xA;    s.StartTime,&#xA;    s.EndTime,&#xA;    s.SourceFile&#xA;FROM staging.Timesheet s&#xA;WHERE s.Processed = 0&#xA;  AND s.EmployeeID IN (SELECT EmployeeID FROM timesheet.Employee)&#xA;  AND s.Comments IS NOT NULL&#xA;  AND s.WorkDate IS NOT NULL&#xA;  AND DATEPART(dw, s.WorkDate) NOT IN (1, 7);  -- Only remove Weekends&#xA;&#xA;-- =============================================&#xA;-- 4. CAPTURE ROWS INSERTED&#xA;-- =============================================&#xA;DECLARE @RowsInserted INT = @@ROWCOUNT;&#xA;&#xA;-- =============================================&#xA;-- 5. MARK PROCESSED&#xA;-- =============================================&#xA;UPDATE staging.Timesheet&#xA;SET Processed = 1, ProcessedAt = GETDATE()&#xA;WHERE Processed = 0&#xA;  AND EmployeeID IN (SELECT EmployeeID FROM timesheet.Employee);&#xA;&#xA;-- =============================================&#xA;-- 6. UPDATE AUDIT LOG&#xA;-- =============================================&#xA;UPDATE audit.AuditLog&#xA;SET &#xA;    RowsInserted = @RowsInserted,&#xA;    LogStatus = 'SUCCESS',&#xA;    Message = CONCAT('Timesheet migration completed. Rows inserted: ', @RowsInserted),&#xA;    ExecutionDurationMs = DATEDIFF(MILLISECOND, LogDateTime, GETDATE())&#xA;WHERE TaskName = 'Timesheet Migration';&#xA;&#xA;-- =============================================&#xA;-- 7. RETURN ROW COUNT TO SSIS&#xA;-- =============================================&#xA;SELECT @RowsInserted AS RowsInserted;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update Audit Log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8F538F78-0FCD-4CD8-B9BD-1BF9383B6336}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Audit Log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12C26D31-71E3-4084-85A3-C3363301A0C8}"
          SQLTask:SqlStatementSource="UPDATE audit.AuditLog &#xA;SET &#xA;    LogStatus = 'SUCCESS',&#xA;    RowsInserted = ?,&#xA;    ExecutionDurationMs = DATEDIFF(MILLISECOND, LogDateTime, GETDATE()),&#xA;    Message = 'Timesheet migration completed successfully'&#xA;WHERE RunNumber = ? AND TaskName = 'Timesheet Migration'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::RunNumber"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
