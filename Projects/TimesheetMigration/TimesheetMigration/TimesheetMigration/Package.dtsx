      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E2A7938E-19ED-4A50-9E63-536CDFAE52A1}"
          SQLTask:SqlStatementSource="-- =========================================================&#xA;-- 4. INSERT EMPLOYEE LEAVE&#xA;-- =========================================================&#xA;&#xA;INSERT INTO timesheet.EmployeeLeave&#xA;(&#xA;    EmployeeID,&#xA;    LeaveType,&#xA;    StartDate,&#xA;    EndDate,&#xA;    NumberOfDays,&#xA;    ApprovalObtained,&#xA;    SickNote,&#xA;    FileName&#xA;)&#xA;SELECT&#xA;    EmployeeID,&#xA;    LeaveType,&#xA;    StartDate,&#xA;    EndDate,&#xA;    NumberOfDays,&#xA;    ApprovalObtained,&#xA;    SickNote,&#xA;    FileName&#xA;FROM StagingTimesheet&#xA;WHERE&#xA;    EmployeeID IS NOT NULL&#xA;    AND LeaveType IS NOT NULL&#xA;    AND LTRIM(RTRIM(LeaveType)) &lt;&gt; ' '&#xA;    AND StartDate IS NOT NULL&#xA;    AND EndDate IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
