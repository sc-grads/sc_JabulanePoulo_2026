          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{E2A7938E-19ED-4A50-9E63-536CDFAE52A1}"
              SQLTask:SqlStatementSource="INSERT INTO timesheet.TimesheetDetail&#xA;(&#xA;    WorkDate,&#xA;    ClientName,&#xA;    ProjectName,&#xA;    WorkDescription,&#xA;    BillableStatus,&#xA;    Comments,&#xA;    TotalHours,&#xA;    StartTime,&#xA;    EndTime,&#xA;    EmployeeID,&#xA;    FileName&#xA;)&#xA;SELECT&#xA;    s.WorkDate,&#xA;    s.ClientName,&#xA;    s.ProjectName,&#xA;    s.WorkDescription,&#xA;    s.BillableStatus,&#xA;    s.Comments,&#xA;    TRY_CAST(s.TotalHours AS DECIMAL(5,2)),&#xA;    TRY_CAST(s.StartTime AS TIME),&#xA;    TRY_CAST(s.EndTime AS TIME),&#xA;    s.EmployeeID,&#xA;    s.FileName&#xA;FROM timesheet.StagingTimesheet s&#xA;WHERE EXISTS (&#xA;    SELECT 1&#xA;    FROM timesheet.Employee e&#xA;    WHERE e.EmployeeID = s.EmployeeID&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
